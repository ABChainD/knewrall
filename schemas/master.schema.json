{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knewrall.com/schemas/master.schema.json",
  "title": "Knewrall Master Node Schema",
  "description": "Unified JSON schema for all node types (Who, What, Where, When, Why, How)",
  "type": "object",
  "required": ["system", "header"],
  "additionalProperties": false,
  "properties": {
    "system": {
      "type": "object",
      "required": ["id", "version", "last_updated"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "UUID identifier (generator emits v4; format itself is not version-pinned)"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Revision counter, incremented on each update"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO‑8601 timestamp of last modification"
        },
        "checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA‑256 hash of the file content (optional)"
        }
      }
    },
    "header": {
      "type": "object",
      "required": ["type", "canonical_name", "aliases"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Who", "What", "Where", "When", "Why", "How"]
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1,
          "description": "Primary identifier for the node"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Alternative names"
        },
        "full_legal_name": {
          "type": "string",
          "description": "Legal or formal name (optional)"
        },
        "disambiguation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context_hint": {
              "type": "string",
              "description": "Short string to distinguish this node"
            },
            "similar_entities": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "uniqueItems": true,
              "description": "UUIDs of nodes with similar names"
            }
          }
        },
        "role_history": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Historical roles or positions (Who nodes)"
        },
        "source_node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Origin node of the reified edge (Why/How nodes)"
        },
        "target_node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Destination node of the reified edge (Why/How nodes)"
        }
      }
    },
    "spatiotemporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_timestamp": {
          "type": "string",
          "description": "ISO-8601 start date/time"
        },
        "end_timestamp": {
          "type": "string",
          "description": "ISO-8601 end date/time"
        },
        "is_relative": {
          "type": "boolean",
          "description": "Whether the time is relative to another event"
        },
        "anchor_node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "UUID of anchor When/Event node"
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lat": {
              "type": "number"
            },
            "long": {
              "type": "number"
            }
          },
          "required": [
            "lat",
            "long"
          ]
        },
        "address": {
          "type": "string"
        },
        "parent_location_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "UUID of parent Where node"
        }
      }
    },
    "descriptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physical": {
          "type": "string",
          "description": "Physical description"
        },
        "psychological": {
          "type": "string",
          "description": "Psychological description"
        },
        "conceptual": {
          "type": "string",
          "description": "Conceptual description"
        }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": ["string", "number", "boolean", "null", "object", "array"],
              "description": "The property value"
            },
            "when": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "description": "UUID of a When node defining temporal validity"
            },
            "where": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "description": "UUID of a Where node defining spatial validity"
            },
            "certainty": {
              "type": "string",
              "enum": ["confirmed", "rumored", "hypothetical", "alternative"],
              "description": "Epistemic certainty of this property"
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_id", "predicate", "direction", "certainty"],
        "additionalProperties": false,
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "UUID of the target node"
          },
          "predicate": {
            "type": "string",
            "description": "Relationship type (e.g., parent_of, employed_by)"
          },
          "direction": {
            "type": "string",
            "enum": ["outbound", "inbound", "bidirectional"]
          },
          "certainty": {
            "type": "string",
            "enum": ["confirmed", "rumored", "hypothetical", "alternative"]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Tags for categorization"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Global tags for the node"
    },
    "code_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol_id", "repo"],
        "additionalProperties": false,
        "properties": {
          "symbol_id": {
            "type": "string",
            "description": "Stable id: <repo_rel_path>::<qualified_name>"
          },
          "repo": {
            "type": "string",
            "description": "Name of the repository (subfolder under projects/)"
          },
          "kind": {
            "type": "string",
            "enum": ["function", "class", "method", "module", "other"],
            "description": "Kind of code symbol"
          }
        }
      },
      "description": "Optional references to code symbols in codegraph.db (ephemeral — warn on miss, do not block)"
    }
  }
}